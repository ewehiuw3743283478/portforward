# Panel listen port (the web UI, not a forwarded port).
PORT=392

# 0.0.0.0 = all interfaces. Use 127.0.0.1 if nginx/Caddy terminates TLS in front.
BIND_HOST=0.0.0.0

# Public IPv4 of this server. Used in the UI and in iptables DNAT rules.
SERVER_PUBLIC_IP=your.public.ip.address

# First-boot login only. After the first start these are hashed into data/auth.json
# and ignored. Changing them here later does not change the live password.
AUTH_USER=admin
AUTH_PASS=change-me-now

# Optional. Auto-generated into data/auth.json on first run if omitted.
# SESSION_SECRET=

# Set both when the panel is served over HTTPS (reverse proxy).
# COOKIE_SECURE=true
# TRUST_PROXY=true
