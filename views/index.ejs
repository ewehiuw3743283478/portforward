<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="app-shell">
<%- include('partials/nav') %>
<main id="main" class="page">
    <div class="page-head">
        <div>
            <h1>Port forwards</h1>
            <p>Send traffic from an inbound NIC to an internal host. Optionally open the same port in UFW and iptables.</p>
        </div>
        <div class="stats">
            <span class="chip"><%= entries.length %> active</span>
            <span class="chip" title="Firewall backends on this host">
                <% if (fwStatus.ufwActive) { %>UFW on<% } else if (fwStatus.ufwInstalled) { %>UFW off<% } else { %>UFW n/a<% } %>
                ·
                <% if (fwStatus.iptables) { %>iptables<% } else { %>no iptables<% } %>
            </span>
        </div>
    </div>

    <%- include('partials/flash') %>

    <% if (!totpEnabled) { %>
    <div class="banner">
        <div>
            <strong>Add an authenticator app</strong>
            <div class="muted">This panel can change firewall rules. A one-time code stops a stolen password from being enough.</div>
        </div>
        <a class="btn btn-small" href="/security">Open security</a>
    </div>
    <% } %>

    <section class="card">
        <h2>Add a forward</h2>
        <p class="card-help">Inbound NIC is where public traffic arrives (or all). Outbound NIC is the card used to reach the destination. Opening the firewall writes matching UFW and iptables filter rules for this port, and removes them when you delete the forward.</p>
        <form id="add-form" action="/add" method="POST" class="stack" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid">
                <label class="field">
                    Destination IP <span class="req">*</span>
                    <input name="ip" placeholder="10.0.0.12" required inputmode="decimal" spellcheck="false">
                    <span class="hint">Internal host that should receive the traffic</span>
                </label>
                <label class="field">
                    Listen port <span class="req">*</span>
                    <input id="listen-port" name="port" placeholder="8080" required inputmode="numeric" pattern="[0-9]{1,5}">
                    <span class="hint">Port opened on the inbound NIC</span>
                </label>
                <label class="field">
                    Destination port <span class="req">*</span>
                    <input id="dest-port" name="toPort" placeholder="80" required inputmode="numeric" pattern="[0-9]{1,5}">
                    <span class="hint">Port on the destination host</span>
                </label>
                <label class="checkline span-all">
                    <input id="same-port" type="checkbox"> Same as listen port
                </label>
                <label class="field">
                    Inbound NIC
                    <select name="inIface">
                        <option value="*" selected>All interfaces</option>
                        <% ifaces.forEach(nic => { %>
                            <option value="<%= nic.name %>"><%= nic.name %><% if (nic.ipv4) { %> — <%= nic.ipv4 %><% } %><% if (nic.state && nic.state !== 'unknown') { %> (<%= nic.state %>)<% } %></option>
                        <% }) %>
                    </select>
                    <span class="hint">Where traffic enters this server</span>
                </label>
                <label class="field">
                    Outbound NIC
                    <select name="outIface">
                        <option value="" selected>Auto (system routing)</option>
                        <% ifaces.forEach(nic => { %>
                            <option value="<%= nic.name %>"><%= nic.name %><% if (nic.ipv4) { %> — <%= nic.ipv4 %><% } %><% if (nic.state && nic.state !== 'unknown') { %> (<%= nic.state %>)<% } %></option>
                        <% }) %>
                    </select>
                    <span class="hint">Card used to reach the destination</span>
                </label>
                <label class="checkline fw-check">
                    <input type="checkbox" name="firewall" value="1" checked>
                    Open this port in UFW and iptables
                </label>
                <div class="field span-all">
                    Protocol
                    <div class="segmented">
                        <label class="choice">
                            <input type="radio" name="protocol" value="tcp" checked>
                            <span class="choice-body">
                                <span class="choice-title">TCP</span>
                                <p>Web, SSH, most apps</p>
                            </span>
                        </label>
                        <label class="choice">
                            <input type="radio" name="protocol" value="udp">
                            <span class="choice-body">
                                <span class="choice-title">UDP</span>
                                <p>Games, DNS, media</p>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="field span-all">
                    Method
                    <div class="segmented">
                        <label class="choice">
                            <input type="radio" name="method" value="socat" checked>
                            <span class="choice-body">
                                <span class="choice-title">socat <span class="badge badge-socat">easy</span></span>
                                <p>Works without extra routing. Destination sees this server's IP, not the original client.</p>
                            </span>
                        </label>
                        <label class="choice">
                            <input type="radio" name="method" value="iptables">
                            <span class="choice-body">
                                <span class="choice-title">iptables <span class="badge badge-iptables">real IP</span></span>
                                <p>Keeps the client IP. The destination host must send replies back through this server.</p>
                            </span>
                        </label>
                    </div>
                </div>
            </div>
            <div id="mapping-preview" class="preview" data-public-ip="<%= publicIp %>"></div>
            <div class="actions-bar">
                <button class="btn btn-primary" type="submit">Add forward</button>
            </div>
        </form>
    </section>

    <section class="card">
        <div class="toolbar">
            <h2>Active forwards</h2>
            <% if (entries.length) { %>
            <input id="forward-filter" class="search" type="search" placeholder="Filter by port, IP, method…">
            <% } %>
        </div>
        <% if (entries.length === 0) { %>
        <div class="empty">
            <h3>Nothing forwarded yet</h3>
            <p>Add a mapping above. It will come back automatically if this process restarts.</p>
        </div>
        <% } else { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Listen</th>
                        <th>Protocol</th>
                        <th>Destination</th>
                        <th>NICs</th>
                        <th>Method</th>
                        <th>Firewall</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                <% entries.forEach(e => { %>
                    <tr data-forward-row data-search="<%= `${e.port} ${e.protocol} ${e.ip} ${e.toPort} ${e.method} ${e.inIface} ${e.outIface}`.toLowerCase() %>">
                        <td>
                            <div class="listen-cell">
                                <span class="mono"><%= e.listenIp %>:<%= e.port %></span>
                                <button type="button" class="btn btn-ghost btn-small" data-copy="<%= e.listenIp %>:<%= e.port %>">Copy</button>
                            </div>
                        </td>
                        <td><span class="badge badge-<%= e.protocol %>"><%= e.protocol %></span></td>
                        <td class="mono"><%= e.ip %>:<%= e.toPort %></td>
                        <td>
                            <span class="mono"><%= e.inIface === '*' ? 'all' : e.inIface %></span>
                            <span class="muted">→</span>
                            <span class="mono"><%= e.outIface || 'auto' %></span>
                        </td>
                        <td><span class="badge badge-<%= e.method %>"><%= e.method %></span></td>
                        <td>
                            <% if (e.firewall) { %>
                                <span class="badge badge-fw-on">open</span>
                            <% } else { %>
                                <span class="badge badge-fw-off">unchanged</span>
                            <% } %>
                        </td>
                        <td>
                            <form action="/remove" method="POST" class="inline-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="port" value="<%= e.port %>">
                                <input type="hidden" name="protocol" value="<%= e.protocol %>">
                                <input type="hidden" name="method" value="<%= e.method %>">
                                <button
                                    type="submit"
                                    class="btn btn-danger btn-small"
                                    data-remove
                                    data-port="<%= e.port %>"
                                    data-protocol="<%= e.protocol %>"
                                    data-method="<%= e.method %>"
                                    data-dest="<%= e.ip %>:<%= e.toPort %>"
                                >Remove</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                <tr data-filter-empty hidden>
                    <td colspan="7" class="empty">No forwards match that filter.</td>
                </tr>
                </tbody>
            </table>
        </div>
        <% } %>
    </section>
</main>

<dialog id="confirm-remove">
    <form action="/remove" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="port">
        <input type="hidden" name="protocol">
        <input type="hidden" name="method">
        <h3>Remove this forward?</h3>
        <p>Traffic to <strong data-remove-label></strong> will stop immediately.</p>
        <div class="dialog-actions">
            <button type="button" class="btn btn-ghost" data-cancel>Keep it</button>
            <button type="submit" class="btn btn-danger">Remove</button>
        </div>
    </form>
</dialog>
<script src="/js/app.js"></script>
</body>
</html>
