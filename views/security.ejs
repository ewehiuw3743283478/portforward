<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body class="app-shell">
<%- include('partials/nav') %>
<main id="main" class="page">
    <div class="page-head">
        <div>
            <h1>Security</h1>
            <p>Password, username, and authenticator app for this panel. These settings are stored hashed on disk, not in <span class="mono">.env</span>.</p>
        </div>
        <span class="chip">
            <span class="status-dot <%= profile.totpEnabled ? '' : 'status-off' %>" aria-hidden="true"></span>
            <%= profile.totpEnabled ? '2FA on' : '2FA off' %>
        </span>
    </div>

    <%- include('partials/flash') %>

    <% if (mustChangePassword) { %>
    <div class="banner">
        <div>
            <strong>Set a panel password</strong>
            <div class="muted">The value in <span class="mono">.env</span> is only a bootstrap secret. Choose a unique password of at least 10 characters.</div>
        </div>
    </div>
    <% } %>

    <% if (freshBackupCodes && freshBackupCodes.length) { %>
    <section class="card">
        <h2>Save these backup codes now</h2>
        <p class="card-help">They are shown once. Each code signs you in if you lose the authenticator app, and each can be used only once.</p>
        <div class="codes">
            <% freshBackupCodes.forEach(code => { %>
                <div class="code-pill"><%= code %></div>
            <% }) %>
        </div>
        <div class="row-actions">
            <button type="button" class="btn" data-copy="<%= freshBackupCodes.join('\n') %>">Copy all</button>
            <form action="/security/backup-codes/ack" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary" type="submit">I saved these codes</button>
            </form>
        </div>
    </section>
    <% } %>

    <div class="grid-2">
        <section class="card">
            <h2>Username</h2>
            <p class="card-help">Current account: <strong><%= currentUser %></strong></p>
            <form action="/security/username" method="POST" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field">
                    New username
                    <input type="text" name="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9._-]+" autocapitalize="none" spellcheck="false" value="<%= currentUser %>">
                </label>
                <label class="field">
                    Current password
                    <input type="password" name="currentPassword" required autocomplete="current-password">
                </label>
                <div class="actions-bar">
                    <button class="btn btn-primary" type="submit">Update username</button>
                </div>
            </form>
        </section>

        <section class="card">
            <h2>Password</h2>
            <p class="card-help">At least 10 characters. Stored with bcrypt. Last changed <%= profile.passwordUpdatedAt ? new Date(profile.passwordUpdatedAt).toLocaleString() : 'never' %>.</p>
            <form action="/security/password" method="POST" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field">
                    Current password
                    <span class="with-action">
                        <input id="current-pass" type="password" name="currentPassword" required autocomplete="current-password">
                        <button type="button" class="btn btn-ghost" data-toggle-password="current-pass">Show</button>
                    </span>
                </label>
                <label class="field">
                    New password
                    <input id="new-pass" type="password" name="newPassword" required minlength="10" maxlength="200" autocomplete="new-password">
                </label>
                <label class="field">
                    Confirm new password
                    <input type="password" name="confirmPassword" required minlength="10" maxlength="200" autocomplete="new-password">
                </label>
                <div class="actions-bar">
                    <button class="btn btn-primary" type="submit">Update password</button>
                </div>
            </form>
        </section>
    </div>

    <section class="card">
        <h2>Authenticator app (TOTP)</h2>
        <p class="card-help">Works with Aegis, Google Authenticator, 1Password, and similar apps. Codes rotate every 30 seconds.</p>

        <% if (profile.totpEnabled) { %>
            <p>Two-factor is <strong>on</strong>. <%= profile.backupCodesRemaining %> backup code<%= profile.backupCodesRemaining === 1 ? '' : 's' %> remaining.</p>
            <% if (profile.lastLoginAt) { %>
                <p class="muted">Last sign-in <%= new Date(profile.lastLoginAt).toLocaleString() %><% if (profile.lastLoginIp) { %> from <span class="mono"><%= profile.lastLoginIp %></span><% } %>.</p>
            <% } %>

            <form action="/security/backup-codes" method="POST" class="stack mt">
                <h2>Replace backup codes</h2>
                <p class="card-help">This invalidates unused codes from the previous set.</p>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field">
                    Current password
                    <input type="password" name="currentPassword" required autocomplete="current-password">
                </label>
                <label class="field">
                    Authenticator code
                    <input id="regen-otp" name="otp" class="otp-input" inputmode="numeric" autocomplete="one-time-code" required>
                </label>
                <div class="actions-bar">
                    <button class="btn" type="submit">Generate new codes</button>
                </div>
            </form>

            <form action="/security/totp/disable" method="POST" class="stack mt-lg">
                <h2>Turn off two-factor</h2>
                <p class="card-help">Requires your password and a current app or backup code.</p>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field">
                    Current password
                    <input type="password" name="currentPassword" required autocomplete="current-password">
                </label>
                <label class="field">
                    Authenticator or backup code
                    <input name="otp" required autocomplete="one-time-code">
                </label>
                <div class="actions-bar">
                    <button class="btn btn-danger" type="submit">Disable authenticator</button>
                </div>
            </form>
        <% } else if (totpSetup) { %>
            <div class="qr-box">
                <img src="<%= totpSetup.qr %>" alt="QR code for authenticator setup" width="180" height="180">
                <div>
                    <p>Scan this QR code, then enter the 6-digit code to confirm. If you cannot scan, type this secret into the app:</p>
                    <div class="secret-box"><%= totpSetup.secret %></div>
                    <p class="hint">Issuer: Port Forward</p>
                </div>
            </div>
            <form action="/security/totp/enable" method="POST" class="stack mt">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="field">
                    6-digit code from the app
                    <input id="otp" class="otp-input" name="otp" inputmode="numeric" autocomplete="one-time-code" required>
                </label>
                <div class="row-actions">
                    <button class="btn btn-primary" type="submit">Enable two-factor</button>
                    <button class="btn btn-ghost" type="submit" form="cancel-totp">Cancel</button>
                </div>
            </form>
            <form id="cancel-totp" action="/security/totp/cancel" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            </form>
        <% } else { %>
            <p>Two-factor is <strong>off</strong>. After you enable it, sign-in will ask for a code from the app.</p>
            <form action="/security/totp/start" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-primary" type="submit">Set up authenticator</button>
            </form>
        <% } %>
    </section>
</main>
<script src="/js/app.js"></script>
</body>
</html>
