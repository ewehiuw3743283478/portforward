<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
<div class="auth-shell">
    <div class="auth-card">
        <%- include('partials/brand') %>
        <h1>Sign in</h1>
        <p class="lede">Use your panel username and password. If two-factor is enabled, you will be asked for a code next.</p>
        <%- include('partials/flash') %>
        <form action="/login" method="POST" class="stack" autocomplete="on">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="field">
                Username
                <input type="text" name="username" required autofocus autocapitalize="none" spellcheck="false" autocomplete="username">
            </label>
            <label class="field">
                Password
                <span class="with-action">
                    <input id="password" type="password" name="password" required autocomplete="current-password">
                    <button type="button" class="btn btn-ghost" data-toggle-password="password">Show</button>
                </span>
            </label>
            <button class="btn btn-primary btn-block" type="submit">Continue</button>
        </form>
    </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
